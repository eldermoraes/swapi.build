## Stage 1: build nativo (Mandrel) — o Quinoa baixa Node 20.18.1 e builda o frontend durante o package
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-24 AS build
USER quarkus
WORKDIR /code
COPY --chown=quarkus:quarkus mvnw /code/mvnw
COPY --chown=quarkus:quarkus .mvn /code/.mvn
COPY --chown=quarkus:quarkus pom.xml /code/
COPY --chown=quarkus:quarkus src /code/src
RUN ./mvnw package -Dnative -DskipTests -Dquarkus.native.native-image-xmx=6g

## Stage 2: runtime micro (~27MB comprimida, como nas tags 1.1-1.6)
FROM quay.io/quarkus/quarkus-micro-image:2.0
WORKDIR /work/
COPY --from=build --chown=1001:root --chmod=0755 /code/target/*-runner /work/application

EXPOSE 5432
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
